{
    "name": "rielpay/laravel",
    "description": "Official Laravel SDK for RielPay — accept KHQR payments from every bank in Cambodia.",
    "keywords": ["rielpay", "khqr", "bakong", "aba", "payway", "cambodia", "payment", "laravel"],
    "homepage": "https://rielpays.com/docs",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.1",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "RielPay\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RielPay\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["RielPay\\Laravel\\RielPayServiceProvider"],
            "aliases": {
                "RielPay": "RielPay\\Laravel\\Facades\\RielPay"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
